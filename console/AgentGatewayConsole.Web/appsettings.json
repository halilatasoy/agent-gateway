{
  "Settings": {
    "Language": "tr",
    "UiPort": 8080,
    "OtlpPort": 4318,
    "OtlpMaxBodyBytes": 16777216,
    "EnforcePortIsolation": true
  },
  "Ingest": {
    "ExcludedAttributePrefixes": [ "agwc.", "llm.prompt", "llm.completion", "gen_ai.prompt", "gen_ai.completion", "gen_ai.input.messages", "gen_ai.output.messages" ]
  },
  "Redaction": {
    "Rules": [
      { "Type": "Iban", "Pattern": "(?i)\\bTR\\d{2}(?:[ ]?\\d{4}){5}[ ]?\\d{2}\\b", "Placeholder": "<IBAN>" },
      { "Type": "CreditCard", "Pattern": "(?<!\\d)(?:\\d[ -]?){12,18}\\d(?!\\d)", "Placeholder": "<KART_NO>" },
      { "Type": "TcKimlik", "Pattern": "(?<!\\d)[1-9]\\d{10}(?!\\d)", "Placeholder": "<TC_KIMLIK_NO>" },
      { "Type": "Phone", "Pattern": "(?<![\\d+])(?:\\+90[ -]?|0)?5\\d{2}[ -]?\\d{3}[ -]?\\d{2}[ -]?\\d{2}(?!\\d)", "Placeholder": "<TELEFON>" },
      { "Type": "Email", "Pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "Placeholder": "<E_POSTA>" }
    ]
  },
  "AllowedHosts": "*"
}
