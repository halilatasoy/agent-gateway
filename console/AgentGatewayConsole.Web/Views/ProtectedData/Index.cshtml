@{
    ViewData["Title"] = _messageService.Get("ProtectedData", "Title");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/ProtectedData/Index.css" asp-append-version="true" />
}

<div class="page-head">
    <div>
        <h1>@_messageService.Get("ProtectedData", "Title")</h1>
        <p class="page-head__lead">@_messageService.Get("ProtectedData", "Subtitle")</p>
    </div>
    <div class="page-head__tools">
        <div class="tray" id="rangeTray" role="group" aria-label="@_messageService.Get("Global", "Range")">
            <button type="button" class="tray__key" data-range="LastHour" aria-pressed="false">@_messageService.Get("Global", "Range1h")</button>
            <button type="button" class="tray__key" data-range="Last24Hours" aria-pressed="false">@_messageService.Get("Global", "Range24h")</button>
            <button type="button" class="tray__key" data-range="Last7Days" aria-pressed="true">@_messageService.Get("Global", "Range7d")</button>
        </div>
    </div>
</div>

<section class="panel" aria-labelledby="listTitle">
    <div class="panel__head">
        <h2 class="panel__title" id="listTitle">@_messageService.Get("ProtectedData", "ListTitle")</h2>
        <span class="panel__meta">@_messageService.Get("ProtectedData", "ListHint")</span>
    </div>
    <div class="table-wrap">
        <table class="data data--clickable" id="protectedTable">
            <thead>
                <tr>
                    <th scope="col">@_messageService.Get("ProtectedData", "Time")</th>
                    <th scope="col">@_messageService.Get("ProtectedData", "Outcome")</th>
                    <th scope="col">@_messageService.Get("ProtectedData", "DataTypes")</th>
                    <th scope="col">@_messageService.Get("ProtectedData", "Phase")</th>
                    <th scope="col">@_messageService.Get("ProtectedData", "Protocol")</th>
                    <th scope="col">@_messageService.Get("ProtectedData", "Model")</th>
                    <th scope="col">@_messageService.Get("ProtectedData", "Client")</th>
                    <th scope="col">@_messageService.Get("ProtectedData", "Status")</th>
                    <th scope="col" class="r">@_messageService.Get("ProtectedData", "Duration")</th>
                    <th scope="col"><span class="visually-hidden">@_messageService.Get("Global", "Details")</span></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<dialog class="inspector" id="detailDialog" aria-labelledby="detailTitle">
    <div class="inspector__bar">
        <div>
            <p class="inspector__eyebrow" id="detailEyebrow">@_messageService.Get("ProtectedData", "DetailTitle")</p>
            <h2 class="inspector__title" id="detailTitle"></h2>
            <div class="inspector__meta" id="detailMeta"></div>
        </div>
        <button type="button" class="key key--icon" data-close aria-label="@_messageService.Get("Global", "Close")">
            <svg class="i" aria-hidden="true"><use href="#i-x" /></svg>
        </button>
    </div>
    <div class="inspector__body">
        <div id="detailContent"></div>

        <section class="section" aria-labelledby="requestTitle">
            <div class="section__head">
                <h3 class="section__title" id="requestTitle">@_messageService.Get("ProtectedData", "Request")</h3>
            </div>
            <dl class="facts" id="detailFacts"></dl>
        </section>

        <section class="section" aria-labelledby="guardrailTitle">
            <div class="section__head">
                <h3 class="section__title" id="guardrailTitle">@_messageService.Get("ProtectedData", "Guardrails")</h3>
            </div>
            <figure class="codeblock">
                <figcaption class="codeblock__bar"><code>agw.ai.guardrails</code><span>JSON</span></figcaption>
                <pre id="detailGuardrails"></pre>
            </figure>
        </section>

        <section class="section">
            <details class="disclosure">
                <summary><svg class="i" aria-hidden="true"><use href="#i-chevron" /></svg>@_messageService.Get("ProtectedData", "RawAttributes")</summary>
                <figure class="codeblock">
                    <figcaption class="codeblock__bar"><span>@_messageService.Get("ProtectedData", "Attributes")</span><span>JSON</span></figcaption>
                    <pre id="detailAttributes"></pre>
                </figure>
            </details>
        </section>
    </div>
</dialog>

<script>window.PageContext = { url: { getList: '@Url.Action("GetList")', getDetail: '@Url.Action("GetDetail")' } };</script>

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/js/pages/ProtectedData/Index.js" asp-append-version="true"></script>
}
